generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Cuenta {
  id                    String                 @id @default(cuid())
  nombre                String
  tipo                  TipoCuenta
  banco                 String?
  ultimosDigitos        String?
  esPrincipal           Boolean                @default(false)
  esCuentaPuente        Boolean                @default(false)
  colorIdentificador    String?
  saldoInicial          Decimal                @default(0)
  diaCierre             Int?
  diaPago               Int?
  diasRecordatorio      Int?                   @default(3)
  limiteCompra          Decimal?
  limiteDisponible      Decimal?
  limiteActualizadoEn   DateTime?
  saldoActualizadoEn    DateTime?
  nombreEntidad         String?                @unique
  compras               Compra[]
  recurrentes           GastoRecurrente[]
  ingresos              Ingreso[]
  resumenes             Resumen[]
  transacciones         Transaccion[]
  transferenciasDestino TransferenciaInterna[] @relation("TransferDestino")
  transferenciasOrigen  TransferenciaInterna[] @relation("TransferOrigen")
}

model Ingreso {
  id                String   @id @default(cuid())
  monto             Decimal  @db.Decimal(10, 2)
  fechaCobro        DateTime
  periodoDisponible String
  cuentaId          String
  categoriaId       String
  categoria         Categoria @relation(fields: [categoriaId], references: [id])
  subcategoriaId    String?
  subcategoria      Subcategoria? @relation(fields: [subcategoriaId], references: [id])
  idempotencyKey    String   @unique
  createdAt         DateTime @default(now())
  cuenta            Cuenta   @relation(fields: [cuentaId], references: [id])
}

model Categoria {
  id                 String              @id @default(cuid())
  nombre             String              @db.VarChar(30)
  icono              IconoCategoria
  color              ColorCategoria
  tipo               TipoCategoria
  activa             Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @default(now()) @updatedAt
  contactosCategoria ContactoCategoria[]
  recurrentes        GastoRecurrente[]
  subcategorias      Subcategoria[]
  transacciones      Transaccion[]
  ingresos           Ingreso[]

  @@unique([nombre, tipo])
}

model Subcategoria {
  id            String            @id @default(cuid())
  nombre        String            @db.VarChar(30)
  categoriaId   String
  recurrentes   GastoRecurrente[]
  categoria     Categoria         @relation(fields: [categoriaId], references: [id])
  transacciones Transaccion[]
  ingresos      Ingreso[]

  @@unique([categoriaId, nombre])
}

model Transaccion {
  id                       String                    @id @default(cuid())
  monto                    Decimal                   @db.Decimal(10, 2)
  moneda                   String                    @default("ARS")
  montoUSD                 Decimal?
  cotizacionUsada          Decimal?
  comercio                 String?
  origen                   OrigenTransaccion
  cuentaId                 String?
  subcategoriaId           String?
  fecha                    DateTime
  estado                   EstadoTransaccion         @default(CONFIRMADA)
  idempotencyKey           String                    @unique
  textoCrudoOCR            String?
  createdAt                DateTime                  @default(now())
  esTransferenciaAPersona  Boolean                   @default(false)
  categoriaId              String
  cuota                    Cuota?                    @relation("TransaccionCuota")
  instanciaGastoRecurrente InstanciaGastoRecurrente? @relation("TransaccionInstanciaRecurrente")
  categoria                Categoria                 @relation(fields: [categoriaId], references: [id])
  cuenta                   Cuenta?                   @relation(fields: [cuentaId], references: [id], onDelete: Restrict)
  subcategoria             Subcategoria?             @relation(fields: [subcategoriaId], references: [id])
}

model Compra {
  id             String   @id @default(cuid())
  montoTotal     Decimal  @db.Decimal(10, 2)
  comercio       String
  fechaCompra    DateTime
  cantidadCuotas Int      @default(1)
  cuentaId       String
  cuenta         Cuenta   @relation(fields: [cuentaId], references: [id])
  cuotas         Cuota[]
}

model Cuota {
  id              String       @id @default(cuid())
  compraId        String
  numeroCuota     Int
  monto           Decimal      @db.Decimal(10, 2)
  fechaImputacion DateTime
  estado          EstadoCuota  @default(PROYECTADO)
  transaccionId   String?      @unique
  compra          Compra       @relation(fields: [compraId], references: [id])
  transaccion     Transaccion? @relation("TransaccionCuota", fields: [transaccionId], references: [id])
}

model Resumen {
  id                     String               @id @default(cuid())
  cuentaId               String
  periodo                String
  montoTotalInformado    Decimal              @db.Decimal(10, 2)
  montoMinimoInformado   Decimal              @db.Decimal(10, 2)
  totalConsumosInformado Decimal?
  montoPagado            Decimal?
  fechaPago              DateTime?
  saldoFinanciado        Decimal              @default(0)
  metodoPagoMinimo       MetodoPagoRecurrente @default(DEBITO_AUTOMATICO)
  estado                 EstadoResumen        @default(PENDIENTE)
  instancias             InstanciaResumen[]
  cuenta                 Cuenta               @relation(fields: [cuentaId], references: [id])
}

model InstanciaResumen {
  id            String                    @id @default(cuid())
  resumenId     String
  montoEsperado Decimal                   @db.Decimal(10, 2)
  fechaEsperada DateTime
  metodoPago    MetodoPagoRecurrente
  estado        EstadoInstanciaRecurrente @default(PROYECTADO)
  resumen       Resumen                   @relation(fields: [resumenId], references: [id])
}

model GastoRecurrente {
  id                 String                     @id @default(cuid())
  nombre             String
  tipoMonto          TipoMonto
  montoFijo          Decimal?
  subcategoriaId     String?
  activo             Boolean                    @default(true)
  cuentaId           String
  metodoPago         MetodoPagoRecurrente
  frecuencia         Frecuencia
  diaDelMes          Int?
  diaDeSemana        Int?
  mesDelAno          Int?
  intervaloQuincenal DateTime?
  notas              String?                    @db.VarChar(60)
  categoriaId        String
  categoria          Categoria                  @relation(fields: [categoriaId], references: [id])
  cuenta             Cuenta                     @relation(fields: [cuentaId], references: [id])
  subcategoria       Subcategoria?              @relation(fields: [subcategoriaId], references: [id])
  instancias         InstanciaGastoRecurrente[]
}

model InstanciaGastoRecurrente {
  id                String                    @id @default(cuid())
  gastoRecurrenteId String
  fechaVencimiento  DateTime
  monto             Decimal?
  montoEsEstimado   Boolean                   @default(false)
  estado            EstadoInstanciaRecurrente @default(PROYECTADO)
  cuentaRealId      String?
  transaccionId     String?                   @unique
  gastoRecurrente   GastoRecurrente           @relation(fields: [gastoRecurrenteId], references: [id])
  transaccion       Transaccion?              @relation("TransaccionInstanciaRecurrente", fields: [transaccionId], references: [id])
}

model TransferenciaInterna {
  id              String   @id @default(cuid())
  cuentaOrigenId  String
  cuentaDestinoId String
  monto           Decimal  @db.Decimal(10, 2)
  fecha           DateTime @default(now())
  nota            String?  @db.VarChar(60)
  createdAt       DateTime @default(now())
  idempotencyKey  String   @unique
  cuentaDestino   Cuenta   @relation("TransferDestino", fields: [cuentaDestinoId], references: [id])
  cuentaOrigen    Cuenta   @relation("TransferOrigen", fields: [cuentaOrigenId], references: [id])
}

model ContactoCategoria {
  id              String    @id @default(cuid())
  nombreDetectado String    @unique
  subcategoriaId  String?
  aliasCBU        String?
  usoCount        Int       @default(0)
  categoriaId     String
  categoria       Categoria @relation(fields: [categoriaId], references: [id])
}

enum TipoCuenta {
  EFECTIVO
  BILLETERA_VIRTUAL
  CUENTA_BANCARIA
  TARJETA_CREDITO
}

enum TipoCategoria {
  GASTO
  INGRESO
}

enum IconoCategoria {
  UTENSILIOS_COCINA
  CARRO
  CASA
  LLAVE
  TELEFONO
  CORAZON
  OCULOS
  SUPER
  GIMNASIO
  LIBROS
  AVION
  OTRO
}

enum ColorCategoria {
  ROJO
  NARANJA
  AMARILLO
  VERDE
  AZUL
  INDIGO
  VIOLETA
  ROSA
  PEZ
  TURQUESA
  BLANCO
  NEGRO
}

enum OrigenTransaccion {
  APPLE_PAY
  OCR_IA
  MANUAL
  RECURRENTE_CONFIRMADO
  RESUMEN_CONFIRMADO
}

enum EstadoTransaccion {
  CONFIRMADA
  PENDIENTE_REVISION
  PENDIENTE_CATEGORIA
}

enum EstadoCuota {
  PROYECTADO
  CONFIRMADO
  OMITIDO
}

enum EstadoResumen {
  PENDIENTE
  PAGADO_TOTAL
  PAGADO_PARCIAL
}

enum TipoMonto {
  FIJO
  VARIABLE
}

enum Frecuencia {
  SEMANAL
  QUINCENAL
  MENSUAL
  ANUAL
}

enum MetodoPagoRecurrente {
  DEBITO_AUTOMATICO
  MANUAL
}

enum EstadoInstanciaRecurrente {
  PROYECTADO
  CONFIRMADO
  OMITIDO
}
