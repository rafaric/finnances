generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Cuenta {
  id                    String                 @id @default(cuid())
  nombre                String
  tipo                  TipoCuenta
  banco                 String?
  ultimosDigitos        String?
  esPrincipal           Boolean                @default(false)
  esCuentaPuente        Boolean                @default(false)
  colorIdentificador    String?
  saldoInicial          Decimal                @default(0)
  diaCierre             Int?
  diaPago               Int?
  cuentaDebitoMinimoId  String?
  diasRecordatorio      Int?                   @default(3)
  limiteCompra          Decimal?
  limiteDisponible      Decimal?
  limiteActualizadoEn   DateTime?
  saldoActualizadoEn    DateTime?
  nombreEntidad         String?                @unique
  compras               Compra[]
  recurrentes           GastoRecurrente[]
  ingresos              Ingreso[]
  resumenes             Resumen[]
  transacciones         Transaccion[]
  transferenciasDestino TransferenciaInterna[] @relation("TransferDestino")
  transferenciasOrigen  TransferenciaInterna[] @relation("TransferOrigen")
  cuentaDebitoMinimo   Cuenta?                @relation("TarjetaDebitoMinimo", fields: [cuentaDebitoMinimoId], references: [id])
  tarjetasDebitoMinimo Cuenta[]               @relation("TarjetaDebitoMinimo")
  pagosResumen         PagoResumen[]           @relation("CuentaPagoResumen")
}

model CicloFinanciero {
  id        String   @id @default(cuid())
  periodo   String   @unique
  inicio    DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([inicio])
}

model Ingreso {
  id                String   @id @default(cuid())
  monto             Decimal  @db.Decimal(10, 2)
  fechaCobro        DateTime
  periodoDisponible String
  iniciaCicloFinanciero Boolean @default(false)
  cuentaId          String
  categoriaId       String
  categoria         Categoria @relation(fields: [categoriaId], references: [id])
  subcategoriaId    String?
  subcategoria      Subcategoria? @relation(fields: [subcategoriaId], references: [id])
  idempotencyKey    String   @unique
  createdAt         DateTime @default(now())
  cuenta            Cuenta   @relation(fields: [cuentaId], references: [id])
}

model Categoria {
  id                 String              @id @default(cuid())
  nombre             String              @db.VarChar(30)
  icono              IconoCategoria
  color              ColorCategoria
  tipo               TipoCategoria
  activa             Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @default(now()) @updatedAt
  contactosCategoria ContactoCategoria[]
  recurrentes        GastoRecurrente[]
  subcategorias      Subcategoria[]
  transacciones      Transaccion[]
  ingresos           Ingreso[]
  compras            Compra[]

  @@unique([nombre, tipo])
}

model Subcategoria {
  id            String            @id @default(cuid())
  nombre        String            @db.VarChar(30)
  categoriaId   String
  activa        Boolean           @default(true)
  recurrentes   GastoRecurrente[]
  categoria     Categoria         @relation(fields: [categoriaId], references: [id])
  transacciones Transaccion[]
  ingresos      Ingreso[]

  @@unique([categoriaId, nombre])
}

model Transaccion {
  id                       String                    @id @default(cuid())
  monto                    Decimal                   @db.Decimal(10, 2)
  moneda                   String                    @default("ARS")
  montoUSD                 Decimal?
  cotizacionUsada          Decimal?
  comercio                 String?
  nota                     String?                   @db.VarChar(120)
  origen                   OrigenTransaccion
  cuentaId                 String?
  subcategoriaId           String?
  fecha                    DateTime
  estado                   EstadoTransaccion         @default(CONFIRMADA)
  idempotencyKey           String                    @unique
  textoCrudoOCR            String?
  createdAt                DateTime                  @default(now())
  esTransferenciaAPersona  Boolean                   @default(false)
  categoriaId              String
  cuota                    Cuota?                    @relation("TransaccionCuota")
  cargoResumen             CargoResumen?
  instanciaGastoRecurrente InstanciaGastoRecurrente? @relation("TransaccionInstanciaRecurrente")
  categoria                Categoria                 @relation(fields: [categoriaId], references: [id])
  cuenta                   Cuenta?                   @relation(fields: [cuentaId], references: [id], onDelete: Restrict)
  subcategoria             Subcategoria?             @relation(fields: [subcategoriaId], references: [id])
}

model Compra {
  id             String   @id @default(cuid())
  montoTotal     Decimal  @db.Decimal(10, 2)
  moneda         String   @default("ARS")
  comercio       String
  fechaCompra    DateTime
  cantidadCuotas Int      @default(1)
  cuentaId       String
  categoriaId    String?
  cuenta         Cuenta   @relation(fields: [cuentaId], references: [id])
  categoria      Categoria? @relation(fields: [categoriaId], references: [id])
  cuotas         Cuota[]
}

model Cuota {
  id              String       @id @default(cuid())
  compraId        String
  numeroCuota     Int
  monto           Decimal      @db.Decimal(10, 2)
  moneda          String       @default("ARS")
  fechaImputacion DateTime
  estado          EstadoCuota  @default(PROYECTADO)
  transaccionId   String?      @unique
  compra          Compra       @relation(fields: [compraId], references: [id])
  transaccion     Transaccion? @relation("TransaccionCuota", fields: [transaccionId], references: [id])

  @@unique([compraId, numeroCuota])
  @@index([fechaImputacion, estado])
}

model Resumen {
  id                     String               @id @default(cuid())
  cuentaId               String
  periodo                String
  fechaCierre            DateTime?
  fechaVencimiento       DateTime?
  montoTotalInformado    Decimal              @db.Decimal(10, 2)
  montoMinimoInformado   Decimal              @db.Decimal(10, 2)
  totalConsumosInformado Decimal?
  totalConsumosUSDInformado Decimal?
  saldoUSDInformado      Decimal?
  montoPagado            Decimal?
  fechaPago              DateTime?
  saldoFinanciado        Decimal              @default(0)
  entidadInformada      String?
  ultimosDigitosInformados String?
  interesesInformados   Decimal?
  impuestosInformados   Decimal?
  comisionesInformadas  Decimal?
  segurosInformados     Decimal?
  confianzaOCR          Decimal?
  diferenciaConciliacion Decimal?
  estadoConciliacion    EstadoConciliacion   @default(PENDIENTE)
  cargos                 CargoResumen[]
  consumosExtraidos      Json?
  metodoPagoMinimo       MetodoPagoRecurrente @default(DEBITO_AUTOMATICO)
  estado                 EstadoResumen        @default(PENDIENTE)
  instancias             InstanciaResumen[]
  pagos                  PagoResumen[]
  cuenta                 Cuenta               @relation(fields: [cuentaId], references: [id])

  @@unique([cuentaId, periodo])
}

model AnalisisInsight {
  id              String         @id @default(cuid())
  periodo         String         @unique
  contenido       String         @db.Text
  estado          EstadoInsight  @default(INVALIDADO)
  huellaDatos     String?
  generadoEn      DateTime?
  invalidadoEn    DateTime        @default(now())
  error           String?         @db.Text
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model CargoResumen {
  id            String             @id @default(cuid())
  resumenId     String
  tipo          TipoCargoResumen
  monto         Decimal            @db.Decimal(10, 2)
  estado        EstadoCargoResumen @default(PENDIENTE)
  transaccionId String?            @unique
  resumen       Resumen            @relation(fields: [resumenId], references: [id])
  transaccion   Transaccion?       @relation(fields: [transaccionId], references: [id])

  @@unique([resumenId, tipo])
}

model PagoResumen {
  id              String                @id @default(cuid())
  resumenId       String
  cuentaOrigenId  String
  monto           Decimal               @db.Decimal(10, 2)
  fecha           DateTime
  tipo            TipoPagoResumen
  transferenciaId String?               @unique
  idempotencyKey  String                @unique
  resumen         Resumen               @relation(fields: [resumenId], references: [id])
  cuentaOrigen    Cuenta                @relation("CuentaPagoResumen", fields: [cuentaOrigenId], references: [id])
  transferencia   TransferenciaInterna? @relation(fields: [transferenciaId], references: [id])

  @@index([resumenId, fecha])
}

model InstanciaResumen {
  id            String                    @id @default(cuid())
  resumenId     String
  montoEsperado Decimal                   @db.Decimal(10, 2)
  fechaEsperada DateTime
  metodoPago    MetodoPagoRecurrente
  estado        EstadoInstanciaRecurrente @default(PROYECTADO)
  resumen       Resumen                   @relation(fields: [resumenId], references: [id])
}

model GastoRecurrente {
  id                 String                     @id @default(cuid())
  nombre             String
  tipoMonto          TipoMonto
  montoFijo          Decimal?
  subcategoriaId     String?
  activo             Boolean                    @default(true)
  cuentaId           String
  metodoPago         MetodoPagoRecurrente
  frecuencia         Frecuencia
  diaDelMes          Int?
  diaDeSemana        Int?
  mesDelAno          Int?
  intervaloQuincenal DateTime?
  notas              String?                    @db.VarChar(60)
  categoriaId        String
  categoria          Categoria                  @relation(fields: [categoriaId], references: [id])
  cuenta             Cuenta                     @relation(fields: [cuentaId], references: [id])
  subcategoria       Subcategoria?              @relation(fields: [subcategoriaId], references: [id])
  instancias         InstanciaGastoRecurrente[]

  @@index([activo, cuentaId])
}

model InstanciaGastoRecurrente {
  id                String                    @id @default(cuid())
  gastoRecurrenteId String
  fechaVencimiento  DateTime
  monto             Decimal?
  montoEsEstimado   Boolean                   @default(false)
  estado            EstadoInstanciaRecurrente @default(PROYECTADO)
  cuentaRealId      String?
  transaccionId     String?                   @unique
  gastoRecurrente   GastoRecurrente           @relation(fields: [gastoRecurrenteId], references: [id])
  transaccion       Transaccion?              @relation("TransaccionInstanciaRecurrente", fields: [transaccionId], references: [id])

  @@unique([gastoRecurrenteId, fechaVencimiento])
  @@index([estado, fechaVencimiento])
}

model TransferenciaInterna {
  id              String   @id @default(cuid())
  cuentaOrigenId  String
  cuentaDestinoId String
  monto           Decimal  @db.Decimal(10, 2)
  fecha           DateTime @default(now())
  nota            String?  @db.VarChar(60)
  createdAt       DateTime @default(now())
  idempotencyKey  String   @unique
  cuentaDestino   Cuenta   @relation("TransferDestino", fields: [cuentaDestinoId], references: [id])
  cuentaOrigen    Cuenta   @relation("TransferOrigen", fields: [cuentaOrigenId], references: [id])
  pagoResumen     PagoResumen?
}

model ContactoCategoria {
  id              String    @id @default(cuid())
  nombreDetectado String    @unique
  subcategoriaId  String?
  aliasCBU        String?
  usoCount        Int       @default(0)
  categoriaId     String
  categoria       Categoria @relation(fields: [categoriaId], references: [id])
}

enum TipoCuenta {
  EFECTIVO
  BILLETERA_VIRTUAL
  CUENTA_BANCARIA
  TARJETA_CREDITO
}

enum TipoCategoria {
  GASTO
  INGRESO
}

enum IconoCategoria {
  UTENSILIOS_COCINA
  CARRO
  CASA
  LLAVE
  TELEFONO
  CORAZON
  OCULOS
  SUPER
  GIMNASIO
  LIBROS
  AVION
  OTRO
}

enum ColorCategoria {
  ROJO
  NARANJA
  AMARILLO
  VERDE
  AZUL
  INDIGO
  VIOLETA
  ROSA
  PEZ
  TURQUESA
  BLANCO
  NEGRO
}

enum OrigenTransaccion {
  APPLE_PAY
  OCR_IA
  MANUAL
  RECURRENTE_CONFIRMADO
  RESUMEN_CONFIRMADO
  CUOTA_CONFIRMADA
}

enum EstadoTransaccion {
  CONFIRMADA
  PENDIENTE_REVISION
  PENDIENTE_CATEGORIA
}

enum EstadoCuota {
  PROYECTADO
  CONFIRMADO
  OMITIDO
}

enum EstadoResumen {
  PENDIENTE
  PAGADO_TOTAL
  PAGADO_PARCIAL
}

enum TipoPagoResumen {
  DEBITO_AUTOMATICO
  MANUAL
}

enum EstadoConciliacion {
  PENDIENTE
  COINCIDE
  CON_DIFERENCIA
}

enum TipoCargoResumen {
  INTERESES
  IMPUESTOS
  COMISIONES
  SEGUROS
  IVA_INTERESES
  IVA_COMISIONES
  IVA_IMPUESTOS
  IMPUESTO_SELLO
}

enum EstadoCargoResumen {
  PENDIENTE
  CONFIRMADO
  OMITIDO
}

enum TipoMonto {
  FIJO
  VARIABLE
}

enum Frecuencia {
  SEMANAL
  QUINCENAL
  MENSUAL
  ANUAL
}

enum MetodoPagoRecurrente {
  DEBITO_AUTOMATICO
  MANUAL
}

enum EstadoInstanciaRecurrente {
  PROYECTADO
  CONFIRMADO
  OMITIDO
}

enum EstadoInsight {
  INVALIDADO
  GENERANDO
  DISPONIBLE
  ERROR
}
